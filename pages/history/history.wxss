.empty { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 80rpx; display: block; margin-bottom: 20rpx; }
.empty-text { color: #999; font-size: 28rpx; display: block; margin-bottom: 30rpx; }
.empty-btn {
  display: inline-block; background: #4A90D9; color: #fff;
  padding: 16rpx 48rpx; border-radius: 32rpx; font-size: 28rpx;
}

.history-item {
  background: #fff; border-radius: 16rpx; padding: 30rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.item-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.item-type {
  background: #EBF3FC; color: #4A90D9; padding: 4rpx 16rpx;
  border-radius: 8rpx; font-size: 22rpx;
}
.item-time { font-size: 22rpx; color: #999; }
.item-topic { font-size: 28rpx; font-weight: 600; display: block; margin-bottom: 12rpx; }
.item-preview {
  font-size: 24rpx; color: #999; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.clear-btn {
  text-align: center; color: #999; font-size: 26rpx; padding: 30rpx;
}