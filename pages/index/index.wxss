.section { margin-bottom: 40rpx; }
.section-title {
  font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; color: #333;
}
.type-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.type-card {
  flex: 1; min-width: 140rpx; text-align: center;
  background: #fff; border-radius: 16rpx; padding: 24rpx 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  border: 2rpx solid transparent; transition: all 0.2s;
}
.type-card.active { border-color: #4A90D9; background: #EBF3FC; }
.type-emoji { font-size: 48rpx; display: block; margin-bottom: 8rpx; }
.type-name { font-size: 24rpx; color: #666; }
.type-card.active .type-name { color: #4A90D9; font-weight: 600; }

.input {
  background: #fff; border-radius: 12rpx; padding: 24rpx;
  font-size: 28rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.style-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.style-tag {
  padding: 12rpx 28rpx; background: #fff; border-radius: 32rpx;
  font-size: 24rpx; color: #666; border: 1rpx solid #E5E5E5;
}
.style-tag.active {
  background: #4A90D9; color: #fff; border-color: #4A90D9;
}

.btn-generate {
  margin-top: 40rpx; background: linear-gradient(135deg, #4A90D9, #357ABD);
  color: #fff; font-size: 32rpx; font-weight: 600;
  border-radius: 48rpx; height: 96rpx; line-height: 96rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.3);
}
.btn-generate[disabled] { opacity: 0.6; }